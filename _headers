# ==========================================================================
# OLHAR — regras de cache e segurança no Cloudflare Pages
# Arquivo sem extensão, na raiz do projeto (ao lado do index.html).
# Ele não é servido como asset: o Pages lê e aplica as regras.
# ==========================================================================

# --- o service worker NUNCA pode ser cacheado -----------------------------
# Se ele ficar preso em cache, o app inteiro trava numa versão antiga e
# nenhuma publicação sua aparece. É a causa número um de "não mudou nada".
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate

# --- HTML: sempre revalidar ------------------------------------------------
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/olhar-simulador-ametropia.html
  Cache-Control: public, max-age=0, must-revalidate
/olhar-simulador-patologias.html
  Cache-Control: public, max-age=0, must-revalidate

# --- manifesto de cenas: muda quando você acrescenta foto ------------------
/cenas/manifest.js
  Cache-Control: public, max-age=0, must-revalidate

# --- as fotos: pesadas e imutáveis, cache longo ----------------------------
# Trocou uma foto? Renomeie o arquivo (avenida-dia-2.jpg) e atualize o
# manifest.js. Cache imutável não revalida — sobrescrever o mesmo nome
# deixaria clientes antigos com a imagem velha por um ano.
/cenas/*
  Cache-Control: public, max-age=31536000, immutable

/icon-192.png
  Cache-Control: public, max-age=604800

# --- segurança -------------------------------------------------------------
# ATENÇÃO: SAMEORIGIN, não DENY. O simulador roda dentro de um <iframe> na
# mesma origem — com DENY o iframe fica em branco e parece que quebrou.
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
